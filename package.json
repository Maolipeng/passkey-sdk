{
  "name": "passkey-sdk-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": "Maolipeng<m384861046@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maolipeng/passkey-sdk.git"
  },
  "homepage": "https://github.com/Maolipeng/passkey-sdk#readme",
  "bugs": {
    "url": "https://github.com/Maolipeng/passkey-sdk/issues"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "dev:server": "turbo dev --filter=@demo/server",
    "dev:web": "turbo dev --filter=@demo/web",
    "dev:demo": "turbo dev --filter=@demo/server --filter=@demo/web",
    "dev:example": "turbo dev --filter=@example/full",
    "clean": "turbo clean && rm -rf node_modules",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "turbo": "^2.5.4"
  },
  "packageManager": "pnpm@10.12.2"
}
