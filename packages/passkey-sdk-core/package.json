{
  "name": "@maolipeng/passkey-sdk-core",
  "version": "1.0.0",
  "description": "Passkey SDK 核心类型定义 - TypeScript types, interfaces, and error classes",
  "author": "Maolipeng<m384861046@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maolipeng/passkey-sdk.git",
    "directory": "packages/passkey-sdk-core"
  },
  "homepage": "https://github.com/Maolipeng/passkey-sdk#readme",
  "bugs": {
    "url": "https://github.com/Maolipeng/passkey-sdk/issues"
  },
  "keywords": [
    "passkey",
    "webauthn",
    "fido2",
    "authentication",
    "typescript",
    "types"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "typecheck": "tsc --noEmit",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
