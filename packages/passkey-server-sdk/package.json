{
  "name": "@maolipeng/passkey-server-sdk",
  "version": "1.0.0",
  "description": "Passkey 后端 SDK - WebAuthn server with Express router and configurable storage adapters",
  "author": "Maolipeng<m384861046@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maolipeng/passkey-sdk.git",
    "directory": "packages/passkey-server-sdk"
  },
  "homepage": "https://github.com/Maolipeng/passkey-sdk#readme",
  "bugs": {
    "url": "https://github.com/Maolipeng/passkey-sdk/issues"
  },
  "keywords": [
    "passkey",
    "webauthn",
    "fido2",
    "authentication",
    "server",
    "express",
    "storage"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./storages": {
      "types": "./dist/storages/index.d.ts",
      "import": "./dist/storages/index.js",
      "require": "./dist/storages/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/storages/index.ts --format cjs,esm --dts",
    "typecheck": "tsc --noEmit",
    "dev": "tsup src/index.ts src/storages/index.ts --format cjs,esm --dts --watch"
  },
  "dependencies": {
    "@maolipeng/passkey-sdk-core": "workspace:*",
    "@simplewebauthn/server": "^13.1.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@simplewebauthn/server": "^13.1.0",
    "express": "^4.18.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  }
}
